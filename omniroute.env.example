# Nombres de las variables de entorno PRIVADAS que usan los servicios locales.
# NO completes este archivo dentro del repo. Copialo a un lugar privado, p. ej.:
#   install -m 600 omniroute.env.example ~/.config/omniroute/omniroute.env
# y referencialo desde la unit con:  EnvironmentFile=%h/.config/omniroute/omniroute.env
# Los nombres exactos pueden variar según la versión/configuración de OmniRoute.

OPENCODE_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
# Clave que DSH envía a OmniRoute (apiKeyEnv en settings.yaml); exportala en el
# entorno desde el que arranca DSH.
OMNIROUTE_API_KEY=
